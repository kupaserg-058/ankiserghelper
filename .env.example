# Telegram Bot Token — получить у @BotFather в Telegram
TELEGRAM_TOKEN=

# Google Gemini API key — бесплатно на https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Модель Gemini (бесплатный tier: 1500 запросов/день, 15 RPM, 1M токенов контекста)
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://ankibot:ankibot@postgres:5432/ankibot
POSTGRES_USER=ankibot
POSTGRES_PASSWORD=ankibot
POSTGRES_DB=ankibot

# Redis
REDIS_URL=redis://redis:6379/0

# Список разрешённых Telegram ID через запятую (узнать свой id можно у @userinfobot)
ALLOWED_USER_IDS=
